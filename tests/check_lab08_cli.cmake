set(fixtures "${OUTPUT_DIR}/lab08-${CHECK}-fixtures")
file(MAKE_DIRECTORY "${fixtures}")

function(invoke expected_exit)
    execute_process(COMMAND "${EMBER}" ${ARGN}
        WORKING_DIRECTORY "${fixtures}"
        OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result TIMEOUT 10)
    if(NOT result STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Exit ${result}, expected ${expected_exit}\n${output}${errors}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(errors "${errors}" PARENT_SCOPE)
endfunction()

function(expect_output expected)
    if(NOT output STREQUAL "${expected}" OR NOT errors STREQUAL "")
        message(FATAL_ERROR "Expected stdout '${expected}' and empty stderr\n${output}${errors}")
    endif()
endfunction()

function(expect_contains actual expected)
    string(FIND "${actual}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing '${expected}' in\n${actual}")
    endif()
endfunction()

if(CHECK STREQUAL "tokens")
    file(WRITE "${fixtures}/loop.asm" "loop: JMP loop\r\n")
    invoke(0 lex loop.asm)
    expect_output("Ident(loop)\nColon\nIdent(JMP)\nIdent(loop)\nNewline\nEof\n")
elseif(CHECK STREQUAL "bytes")
    file(WRITE "${fixtures}/halt.asm" "HALT")
    file(WRITE "${fixtures}/jump.asm" "JMP 0x0123\n")
    invoke(0 asm halt.asm)
    expect_output("00\n")
    invoke(0 asm jump.asm)
    expect_output("30 23 01\n")
elseif(CHECK STREQUAL "programs")
    invoke(0 "${SOURCE_DIR}/programs/hello.asm")
    expect_output("HELLO\n")
    invoke(0 "${SOURCE_DIR}/programs/search.asm")
    expect_output("2 \n")
    invoke(0 "${SOURCE_DIR}/programs/fib.asm")
    expect_output("8 \n")

    file(READ "${SOURCE_DIR}/programs/fib.asm" fib)
    string(REPLACE "6 ; n" "10 ; n" fib "${fib}")
    file(WRITE "${fixtures}/fib10.asm" "${fib}")
    invoke(0 fib10.asm)
    expect_output("55 \n")
    file(READ "${SOURCE_DIR}/programs/search.asm" search)
    string(REPLACE "0x41 ; in-range matches" "0x42 ; in-range matches" search "${search}")
    file(WRITE "${fixtures}/search-missing.asm" "${search}")
    invoke(0 search-missing.asm)
    expect_output("255 \n")
elseif(CHECK STREQUAL "errors")
    file(WRITE "${fixtures}/bad-number.asm" "NOP\nLOADI A, 0xGG\n")
    file(WRITE "${fixtures}/undefined.asm" "NOP\nJMP nowhere\n")
    file(WRITE "${fixtures}/bad-cpu.asm" "RET\n")
    file(WRITE "${fixtures}/limit.asm" "loop: JMP loop\n")
    invoke(1 lex bad-number.asm)
    expect_contains("${errors}" "bad-number.asm: line 2: bad number")
    invoke(1 undefined.asm)
    expect_contains("${errors}" "undefined.asm: line 2: undefined label 'nowhere'")
    invoke(1 asm undefined.asm)
    if(NOT output STREQUAL "")
        message(FATAL_ERROR "Failed assembly must emit no bytes\n${output}")
    endif()
    expect_contains("${errors}" "undefined.asm: line 2: undefined label 'nowhere'")
    invoke(1 missing.asm)
    expect_contains("${errors}" "cannot open file: missing.asm")
    file(MAKE_DIRECTORY "${fixtures}/directory.asm")
    invoke(1 directory.asm)
    if(NOT errors MATCHES "cannot (open|read) file: directory[.]asm")
        message(FATAL_ERROR "Expected a file I/O error\n${output}${errors}")
    endif()
    invoke(1 bad-cpu.asm)
    expect_output("CPU error: stack underflow (PC=0)\n")
    invoke(1 limit.asm)
    expect_output("CPU error: instruction limit reached (PC=0)\n")
elseif(CHECK STREQUAL "repl")
    file(MAKE_DIRECTORY "${fixtures}/folder")
    file(WRITE "${fixtures}/folder/with space.asm" "HALT\n")
    file(WRITE "${fixtures}/broken.asm" "NOP\nJMP nowhere\n")
    set(good_path "folder/with space.asm")
    if(WIN32)
        set(good_path "folder\\with space.asm")
    endif()
    file(WRITE "${fixtures}/input.txt"
        "set 0 0x55\nset 100 65\nset 2048 66\nreg a 7\nstep\nasm broken.asm\nregs\nget 0\n"
        "lex \"${good_path}\"\nasm \"${good_path}\"\nregs\nget 100\nget 2048\nrun\nregs\nquit\n")
    execute_process(COMMAND "${EMBER}" INPUT_FILE "${fixtures}/input.txt"
        WORKING_DIRECTORY "${fixtures}"
        OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result TIMEOUT 10)
    if(NOT result STREQUAL "0" OR NOT errors STREQUAL "broken.asm: line 2: undefined label 'nowhere'\n")
        message(FATAL_ERROR "REPL exit=${result}\n${output}${errors}")
    endif()
    expect_contains("${output}" "CPU error: stack underflow (PC=0)")
    expect_contains("${output}" "PC=0 A=7 B=0 Z=0 N=0 C=0 H=0 SP=0xFFF")
    expect_contains("${output}" "85  0x55  0b01010101")
    expect_contains("${output}" "Ident(HALT)\nNewline\nEof")
    expect_contains("${output}" "loaded 1 byte at 0x000")
    expect_contains("${output}" "PC=0 A=0 B=0 Z=0 N=0 C=0 H=0 SP=0xFFF")
    expect_contains("${output}" "0  0x00  0b00000000")
    expect_contains("${output}" "66  0x42  0b01000010")
    expect_contains("${output}" "PC=1 A=0 B=0 Z=0 N=0 C=0 H=0 SP=0xFFF")
else()
    message(FATAL_ERROR "Unknown Lab 08 CLI check '${CHECK}'")
endif()
