execute_process(
    COMMAND "${EMBER}"
    INPUT_FILE "${SOURCE_DIR}/checks/${CHECK}.txt"
    OUTPUT_VARIABLE output
    ERROR_VARIABLE errors
    RESULT_VARIABLE result
    TIMEOUT 10)
file(WRITE "${OUTPUT_DIR}/${CHECK}-output.txt" "${output}${errors}")
if(NOT result EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "${CHECK}: exit=${result}; stderr=${errors}")
endif()
if(output MATCHES "unknown command")
    message(FATAL_ERROR "${CHECK}: unimplemented CLI command\n${output}")
endif()
if(NOT CHECK MATCHES "^(lab-03-limit|lab-04-limit|lab-04-unknown)$" AND output MATCHES "CPU error:")
    message(FATAL_ERROR "${CHECK}: unexpected CPU fault\n${output}")
endif()

function(expect text)
    string(FIND "${output}" "${text}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${CHECK}: missing '${text}'\n${output}")
    endif()
endfunction()

if(CHECK STREQUAL "lab-01")
    expect("65  0x41  0b01000001  'A'")
    expect("66  0x42  0b01000010  'B'")
    expect("0  0x00  0b00000000  '.'")
    expect("address 5000 is outside 0..4095")
    expect("a byte is 0..255, got 300")
    expect("0000  41 42 00 00 00 00 00 00 00 00 00 00 00 00 00 00  |AB..............|")
    expect("0ff0  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00  |................|")
elseif(CHECK STREQUAL "lab-02")
    expect("PC=0 A=200 B=100 Z=0 N=0 C=0")
    expect("PC=1 A=44 B=100 Z=0 N=0 C=1")
    expect("halted")
    expect("PC=2 A=44 B=100 Z=0 N=0 C=1")
elseif(CHECK STREQUAL "lab-02-and")
    expect("PC=1 A=1 B=1 Z=0 N=0 C=0")
    expect("PC=2 A=1 B=1 Z=0 N=0 C=0")
elseif(CHECK STREQUAL "lab-02-trace")
    expect("PC=0 A=64 B=1 Z=0 N=0 C=0")
    expect("PC=1 A=128 B=1 Z=0 N=1 C=0")
    expect("PC=2 A=0 B=1 Z=1 N=0 C=1")
    expect("PC=3 A=1 B=1 Z=0 N=0 C=1")
    expect("PC=4 A=1 B=1 Z=0 N=0 C=1")
    string(REGEX MATCHALL "PC=4 A=1 B=1 Z=0 N=0 C=1" stopped_states "${output}")
    list(LENGTH stopped_states count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "HALT must freeze the state on the next step")
    endif()
elseif(CHECK STREQUAL "lab-02-input")
    expect("usage: reg <a|b> <0..255>")
    string(REGEX MATCHALL "usage: reg <a\\|b> <0\\.\\.255>" rejected "${output}")
    list(LENGTH rejected count)
    if(NOT count EQUAL 5)
        message(FATAL_ERROR "Expected five invalid register inputs to be rejected")
    endif()
    expect("unknown register: c")
    expect("address must not be negative")
    expect("0  0x00  0b00000000  '.'")
    expect("126  0x7e  0b01111110  '~'")
    expect("address 4096 is outside 0..4095")
    expect("PC=0 A=255 B=0 Z=0 N=0 C=0")
    expect("PC=1 A=254 B=0 Z=0 N=1 C=0")
    expect("PC=2 A=254 B=0 Z=0 N=1 C=0")
    expect("halted")
    expect("usage: inc <addr>")
    string(REGEX MATCHALL "0  0x00  0b00000000" zero_bytes "${output}")
    list(LENGTH zero_bytes zero_count)
    if(NOT zero_count EQUAL 2)
        message(FATAL_ERROR "inc 10 must wrap 255 to 0")
    endif()
elseif(CHECK STREQUAL "lab-03" OR CHECK STREQUAL "lab-03-h")
    expect("ember> AB\n")
    expect("PC=9 A=66 B=0 Z=0 N=0 C=0 H=2049")
    if(CHECK STREQUAL "lab-03-h")
        expect("0000  28 00 08 29 02 2b 29 02 00 00 00 00 00 00 00 00")
        expect("0800  41 42 43 00 00 00 00 00 00 00 00 00 00 00 00 00  |ABC.............|")
    endif()
elseif(CHECK STREQUAL "lab-03-trace")
    foreach(state IN ITEMS "0 A=0 B=0 Z=0 N=0 C=0 H=0"
                           "3 A=0 B=0 Z=0 N=0 C=0 H=2048"
                           "4 A=65 B=0 Z=0 N=0 C=0 H=2048"
                           "5 A=65 B=0 Z=0 N=0 C=0 H=2048"
                           "6 A=65 B=0 Z=0 N=0 C=0 H=2049"
                           "7 A=66 B=0 Z=0 N=0 C=0 H=2049"
                           "8 A=66 B=0 Z=0 N=0 C=0 H=2049"
                           "9 A=66 B=0 Z=0 N=0 C=0 H=2049")
        expect("PC=${state}")
    endforeach()
    expect("ember> Aember>")
    expect("ember> Bember>")
    expect("0800  41 42 43 00")
elseif(CHECK STREQUAL "lab-03-absolute")
    expect("ember> AB66 \n")
    expect("PC=24 A=66 B=66 Z=0 N=0 C=0 H=0")
    expect("0800  41 42 43 00")
    expect("0810  41 42 00 00")
elseif(CHECK STREQUAL "lab-03-word")
    expect("ember> 4660\n")
    expect("0000  34 12 00 00")
    expect("ember> 43981\n")
    expect("word address must be 0..4094")
    expect("a word is 0..65535")
    expect("usage: set16 <addr> <0..65535>")
    expect("usage: get16 <addr>")
    expect("171  0xab  0b10101011  '.'")
elseif(CHECK STREQUAL "lab-03-limit")
    expect("CPU error: instruction limit reached (PC=1)")
    expect("PC=1 A=0 B=0 Z=0 N=0 C=0 H=0")
    expect("usage: run [positive instruction limit]")
    string(REGEX MATCHALL "PC=1 A=0 B=0 Z=0 N=0 C=0 H=0" states "${output}")
    list(LENGTH states count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Fault must freeze subsequent step")
    endif()
elseif(CHECK STREQUAL "lab-04" OR CHECK STREQUAL "lab-04-trace")
    if(CHECK STREQUAL "lab-04")
        expect("ember> 3 2 1 \n")
    else()
        foreach(state IN ITEMS "0 A=0 B=0 Z=0" "2 A=3 B=0 Z=0" "3 A=3 B=0 Z=0"
                "4 A=2 B=0 Z=0" "2 A=2 B=0 Z=0" "3 A=2 B=0 Z=0"
                "4 A=1 B=0 Z=0" "2 A=1 B=0 Z=0" "3 A=1 B=0 Z=0"
                "4 A=0 B=0 Z=1" "7 A=0 B=0 Z=1")
            expect("PC=${state}")
        endforeach()
    endif()
    expect("PC=8 A=0 B=0 Z=1 N=0 C=0 H=0")
elseif(CHECK STREQUAL "lab-04-search-found")
    expect("found address=2050 index=2")
    expect("ember> 2 \n")
    expect("PC=24 A=2 B=65 Z=1 N=0 C=0 H=2050")
elseif(CHECK STREQUAL "lab-04-search-missing")
    expect("not found")
    expect("ember> 255 \n")
    expect("PC=28 A=255 B=8 Z=1 N=0 C=0 H=2056")
elseif(CHECK STREQUAL "lab-04-find")
    expect("found address=2048 index=0")
    expect("found address=2050 index=1")
    expect("found address=4095 index=0")
    expect("find range must satisfy 0 <= lo <= hi <= 4096")
    expect("a byte is 0..255")
    expect("usage: find <lo> <hi> <byte>")
    string(REGEX MATCHALL "ember> not found" misses "${output}")
    list(LENGTH misses count)
    if(NOT count EQUAL 4)
        message(FATAL_ERROR "Expected four missing/empty ranges")
    endif()
    expect("PC=0 A=0 B=0 Z=0 N=0 C=0 H=0")
elseif(CHECK STREQUAL "lab-04-unknown")
    expect("CPU error: unknown opcode 0xff (PC=0)")
    expect("PC=0 A=0 B=0 Z=0 N=0 C=0 H=0")
elseif(CHECK STREQUAL "lab-04-limit")
    expect("CPU error: instruction limit reached (PC=0)")
    expect("PC=0 A=0 B=0 Z=0 N=0 C=0 H=0")
else()
    message(FATAL_ERROR "Unknown check: ${CHECK}")
endif()
message(STATUS "${CHECK}: PASS")
