execute_process(COMMAND "${EXPERIMENT}" OUTPUT_VARIABLE output ERROR_VARIABLE errors
                RESULT_VARIABLE result TIMEOUT 10)
file(WRITE "${OUTPUT_DIR}/${CHECK}-output.txt" "${output}${errors}")
if(NOT result EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "${CHECK}: exit=${result}; stderr=${errors}")
endif()
string(REPLACE "\r\n" "\n" output "${output}")
if(CHECK STREQUAL "assignment_experiment")
    set(expected "yes 1\nafter assignment zero: 0\ncomparison true\n")
elseif(CHECK STREQUAL "control_experiments")
    set(expected "A\nAB\nB\nBA\nnull guard=0\nlogical=1 bitwise=0\n12\nif one\nelse nonzero\nwhile=0\ndo-while=1\nfor=0 1 2 \nwhile countdown=3 2 1 \n")
elseif(CHECK STREQUAL "scope_experiments")
    set(expected "10 1\n1\n1 1\n2 1\n3 1\n")
else()
    message(FATAL_ERROR "Unknown experiment ${CHECK}")
endif()
if(NOT output STREQUAL expected)
    message(FATAL_ERROR "${CHECK}: unexpected actual output:\n${output}")
endif()
